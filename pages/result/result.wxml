<!--pages/result/result.wxml-->
<navigation-bar title="支付与开锁" back="{{true}}" color="black" background="#F5F6F8"></navigation-bar>

<view class="page">
  <scroll-view class="page-scroll" scroll-y type="list">
    <view wx:if="{{error}}" class="state">
      <text class="state-icon">🧾</text>
      <text class="muted">{{error}}</text>
      <view class="btn ghost small retry" hover-class="hover" bindtap="goHome">
        <text>返回首页</text>
      </view>
    </view>

    <block wx:else>
      <view class="page-pad">
        <view class="status-card">
          <text class="status-icon">{{icon}}</text>
          <text class="status-title {{titleClass}}">{{title}}</text>
          <text class="status-desc">{{desc}}</text>
          <text wx:if="{{phase === 'opened' && countdown > 0}}" class="countdown">
            请在 {{countdown}} 秒内取走商品并随手关门
          </text>
          <text wx:if="{{failReason}}" class="status-reason">{{failReason}}</text>
        </view>

        <view class="steps">
          <view class="step-dot {{stepIndex >= 1 ? 'done' : (stepIndex === 0 ? 'current' : '')}}">
            <text>1</text>
          </view>
          <text class="step-label">微信支付</text>
          <view class="step-line {{stepIndex >= 1 ? 'done' : ''}}"></view>
          <view class="step-dot {{stepIndex >= 2 ? 'done' : (stepIndex === 1 ? 'current' : '')}}">
            <text>2</text>
          </view>
          <text class="step-label">下发开锁</text>
          <view class="step-line {{stepIndex >= 3 ? 'done' : ''}}"></view>
          <view class="step-dot {{stepIndex >= 3 ? 'done' : (stepIndex === 2 ? 'current' : '')}}">
            <text>3</text>
          </view>
          <text class="step-label">盒门弹开</text>
        </view>

        <view class="card order-card">
          <view class="row-between info-row">
            <text class="muted">盒子</text>
            <text>{{order.boxName}}</text>
          </view>
          <view class="row-between info-row">
            <text class="muted">订单号</text>
            <text>{{order.orderNo}}</text>
          </view>
          <view class="row-between info-row">
            <text class="muted">下单时间</text>
            <text>{{order.createdAtText}}</text>
          </view>

          <view class="divider"></view>

          <view wx:for="{{order.items}}" wx:key="goodsId" class="row-between item-row">
            <text class="item-name ellipsis">{{item.name}} × {{item.count}}</text>
            <text>¥{{item.amountYuan}}</text>
          </view>

          <view class="divider"></view>

          <view class="row-between">
            <text class="muted">实付金额</text>
            <text class="price total-price">¥{{order.totalYuan}}</text>
          </view>
        </view>

        <view class="safe-bottom"></view>
      </view>
    </block>
  </scroll-view>

  <view wx:if="{{!error}}" class="footer safe-bottom">
    <block wx:if="{{phase === 'unpaid' || phase === 'payFailed'}}">
      <view class="btn block" hover-class="hover" bindtap="startPay">
        <text>微信支付 ¥{{order.totalYuan}}</text>
      </view>
      <view class="btn ghost block sub" hover-class="hover" bindtap="goHome">
        <text>返回首页</text>
      </view>
    </block>

    <view wx:elif="{{phase === 'paying'}}" class="btn block disabled">
      <text>正在唤起微信支付…</text>
    </view>

    <view wx:elif="{{phase === 'unlocking'}}" class="btn block disabled">
      <text>正在向盒子发送开锁信号…</text>
    </view>

    <view wx:elif="{{phase === 'opened'}}" class="btn block" hover-class="hover" bindtap="goHome">
      <text>已取货并关门</text>
    </view>

    <block wx:elif="{{phase === 'unlockFailed'}}">
      <view class="btn block" hover-class="hover" bindtap="onRetryUnlock">
        <text>重新开锁</text>
      </view>
      <view class="btn ghost block sub" hover-class="hover" bindtap="onRefund">
        <text>开锁失败，申请退款</text>
      </view>
    </block>

    <block wx:elif="{{phase === 'refunded'}}">
      <view class="btn ghost block" hover-class="hover" bindtap="goHome">
        <text>返回首页</text>
      </view>
    </block>
  </view>
</view>
