/**pages/result/result.wxss**/
.page-pad {
  padding: 24rpx 24rpx 0;
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 180rpx 40rpx 0;
}

.state-icon {
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: 28rpx;
}

.retry {
  margin-top: 36rpx;
}

.status-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 56rpx 32rpx 40rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.status-icon {
  font-size: 96rpx;
  line-height: 1;
}

.status-title {
  display: block;
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: 600;
}

.title-normal {
  color: var(--text);
}

.title-success {
  color: var(--brand-deep);
}

.title-danger {
  color: var(--danger);
}

.status-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

.countdown {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--warning);
}

.status-reason {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--danger);
}

.steps {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
}

.step-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background-color: #e4e7ea;
  color: #ffffff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-dot.current {
  background-color: var(--warning);
}

.step-dot.done {
  background-color: var(--brand);
}

.step-label {
  font-size: 22rpx;
  color: var(--text-sub);
  margin: 0 8rpx;
}

.step-line {
  flex: 1;
  height: 2rpx;
  background-color: var(--line);
  margin: 0 8rpx;
}

.step-line.done {
  background-color: var(--brand);
}

.order-card {
  margin: 0 0 24rpx;
}

.info-row {
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.item-row {
  margin-bottom: 14rpx;
  font-size: 26rpx;
}

.item-name {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.total-price {
  font-size: 34rpx;
}

.footer {
  display: flex;
  flex-direction: column;
  padding: 16rpx 24rpx;
  background-color: #ffffff;
  border-top: 2rpx solid var(--line);
}

.sub {
  margin-top: 16rpx;
}
